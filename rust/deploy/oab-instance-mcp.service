[Unit]
Description=oab-instance-mcp (MCP server exposing this machine to the tailnet)
Documentation=https://github.com/openabdev/instance-mcp
# Start with the desktop session so WAYLAND_DISPLAY etc. are in the environment.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/oab-instance-mcp --host @HOST@ --port @PORT@ @AUTH_ARGS@ @EXTRA_ARGS@
Restart=on-failure
# Apps started through `exec` (a browser, an editor) belong to the user's desktop, not to
# this daemon: a restart or upgrade must not kill them.
KillMode=process
RestartSec=2

[Install]
WantedBy=graphical-session.target
